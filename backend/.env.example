# Supabase project settings (never commit real secrets)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Text and image-understanding provider (OpenRouter)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional image generation provider (OpenAI-compatible endpoint)
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_API_KEY=YOUR_IMAGE_PROVIDER_KEY
IMAGE_MODEL=gpt-image-1

# Comma-separated production frontend origins
ALLOWED_ORIGINS=*
